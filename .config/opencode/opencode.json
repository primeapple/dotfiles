{
    "$schema": "https://opencode.ai/config.json",
    "model": "",
    "theme": "kanagawa",
    "disabled_providers": ["anthropic", "openapi"],
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "api-key": "not-needed",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "gemma4-26b-mlx": {
                    "id": "gemma-4-26B-A4B-it-MLX-4bit",
                    "name": "Gemma4 26b MLX"
                },
                "qwen3.6-27b-mlx": {
                    "id": "qwen3.6-27b-mlx",
                    "name": "qwen3.6 27b MLX"
                }
            }
        }
    },
    "permission": {
        "bash": {
            "*": "ask",
            "./mvnw *": "allow",
            "./gradlew *": "allow",
            "base64 *": "allow",
            "cat *": "allow",
            "diff *": "allow",
            "echo *": "allow",
            "false": "allow",
            "find * -delete *": "ask",
            "find * -exec *": "ask",
            "find * -execdir *": "ask",
            "find * -ok *": "ask",
            "find * -okdir *": "ask",
            "find *": "allow",
            "gh issue list": "allow",
            "gh issue view *": "allow",
            "gh pr checks *": "allow",
            "gh pr list *": "allow",
            "gh pr view *": "allow",
            "gh repo list *": "allow",
            "gh repo view *": "allow",
            "gh run list *": "allow",
            "gh run view *": "allow",
            "gh search *": "allow",
            "git branch --show-current": "allow",
            "git diff *": "allow",
            "git grep *": "allow",
            "git ls-files *": "allow",
            "git log *": "allow",
            "git show *": "allow",
            "git status *": "allow",
            "go test *": "allow",
            "gofmt *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "jar tf *": "allow",
            "jar xf *": "allow",
            "javap *": "allow",
            "jq *": "allow",
            "ls *": "allow",
            "make *": "allow",
            "mkdir *": "allow",
            "mvn *": "allow",
            "mvnd *": "allow",
            "npm ls *": "allow",
            "npm run build": "allow",
            "npm test *": "allow",
            "npm view *": "allow",
            "npx jest *": "allow",
            "nvm *": "allow",
            "pwd *": "allow",
            "rg *": "allow",
            "sed * -i *": "ask",
            "sed * --in-place *": "ask",
            "sed *": "allow",
            "sleep *": "allow",
            "sort *": "allow",
            "tail *": "allow",
            "true": "allow",
            "uniq *": "allow",
            "unzip *": "allow",
            "wc *": "allow",
            "xargs grep *": "allow",
            "xargs rg *": "allow"
        },
        "edit": "allow",
        "external_directory": "ask",
        "webfetch": "allow"
    },
    "plugin": [
        "@mohak34/opencode-notifier@0.2.5"
    ],
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        }
    }
}
