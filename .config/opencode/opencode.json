{
    "$schema": "https://opencode.ai/config.json",
    "model": "",
    "theme": "kanagawa",
    "disabled_providers": ["anthropic", "openapi"],
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "api-key": "not-needed",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "gemma4-26b-mlx": {
                    "id": "gemma-4-26B-A4B-it-MLX-4bit",
                    "name": "Gemma4 26b MLX"
                },
                "qwen3.6-27b-mlx": {
                    "id": "qwen3.6-27b-mlx",
                    "name": "qwen3.6 27b MLX"
                }
            }
        }
    },
    "permission": {
        "*": "ask",
        "bash": "allow",
        "edit": "allow",
        "external_directory": "ask",
        "webfetch": "allow"
    },
    "plugin": [
        "@mohak34/opencode-notifier@0.2.5"
    ],
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        }
    }
}
